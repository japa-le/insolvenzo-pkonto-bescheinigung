# .gitignore for the insolvenzo-form WordPress plugin

# macOS / Windows
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Node / JS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
.cache/

# Build / distribution directories
dist/
build/
public/build/
public/dist/

# Logs
logs/
*.log

# PHP / Composer
vendor/
composer.phar
.phpunit.result.cache

# WordPress / backups / exports
wp-config.php
*.sql
*.sql.gz

# Environment files
.env
.env.*.local

# Coverage & test output
coverage/
.nyc_output/

# Archive files (release bundles)
*.zip
*.tar.gz

